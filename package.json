{
  "name": "afeb-prototipado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b",
    "format": "prettier --write src vite.config.ts docs/*.md README.md",
    "format:check": "prettier --check src vite.config.ts docs/*.md README.md",
    "mock:check": "node scripts/check-mock-db.mjs",
    "mock:flows": "node scripts/check-mock-backend.mjs",
    "design:assets": "node scripts/prepare-design-system.mjs",
    "design:package": "npm run design:assets && python3 scripts/package-design-system.py"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
