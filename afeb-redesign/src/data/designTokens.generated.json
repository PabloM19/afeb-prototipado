{
  "version": "1.0",
  "scope": "AFEB · propuesta de interfaz web",
  "source": "src/styles.css",
  "variables": {
    "--ink": "#203c30",
    "--forest": "#153e30",
    "--forest-deep": "#103426",
    "--lime": "#b7d96c",
    "--brand": "#87bc23",
    "--paper": "#fbfcf9",
    "--warm": "#f1f3ec",
    "--white": "#fff",
    "--muted": "#536356",
    "--line": "#dfe5db",
    "--font": "'Manrope Variable', sans-serif",
    "--text-body": "1rem",
    "--text-small": ".875rem",
    "--text-label": ".75rem",
    "--text-card": "clamp(1.375rem, 1.9vw, 1.75rem)",
    "--text-section": "clamp(2.125rem, 3.45vw, 3.25rem)",
    "--text-hero": "clamp(3.125rem, 5.15vw, 4.75rem)",
    "--container": "1280px",
    "--gutter": "clamp(24px, 5.55vw, 88px)",
    "--section-space": "96px"
  },
  "colors": [
    {
      "name": "forest",
      "label": "Bosque",
      "usage": "Acciones principales y superficies de contraste.",
      "token": "--forest",
      "value": "#153e30"
    },
    {
      "name": "ink",
      "label": "Tinta",
      "usage": "Texto principal y títulos.",
      "token": "--ink",
      "value": "#203c30"
    },
    {
      "name": "forest-deep",
      "label": "Bosque profundo",
      "usage": "Texto sobre el acento lima.",
      "token": "--forest-deep",
      "value": "#103426"
    },
    {
      "name": "brand",
      "label": "Verde AFEB",
      "usage": "Identidad, indicadores y pequeños acentos.",
      "token": "--brand",
      "value": "#87bc23"
    },
    {
      "name": "lime",
      "label": "Lima",
      "usage": "Acciones y énfasis sobre fondos oscuros.",
      "token": "--lime",
      "value": "#b7d96c"
    },
    {
      "name": "paper",
      "label": "Papel",
      "usage": "Fondo principal de la web.",
      "token": "--paper",
      "value": "#fbfcf9"
    },
    {
      "name": "warm",
      "label": "Neutro cálido",
      "usage": "Secciones alternas y agrupaciones.",
      "token": "--warm",
      "value": "#f1f3ec"
    },
    {
      "name": "white",
      "label": "Blanco",
      "usage": "Tarjetas, campos y soportes de marca.",
      "token": "--white",
      "value": "#fff"
    },
    {
      "name": "muted",
      "label": "Texto secundario",
      "usage": "Descripciones, ayudas y metadatos.",
      "token": "--muted",
      "value": "#536356"
    },
    {
      "name": "line",
      "label": "Línea",
      "usage": "Divisores y bordes sobre fondos claros.",
      "token": "--line",
      "value": "#dfe5db"
    }
  ],
  "interface": {
    "radius": "3px",
    "border": "1px solid var(--line)",
    "controlHeight": "52–55px",
    "focus": "3px solid #578312",
    "focusOffset": "5px",
    "transition": "200ms ease"
  },
  "extensions": {
    "note": "Componentes de referencia; se integran cuando una pantalla los necesita.",
    "success": "#153e30",
    "info": "#31576b",
    "warning": "#7c5b19",
    "danger": "#9a3d32",
    "spacingScale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ]
  },
  "responsive": {
    "navigation": "≤1240px",
    "homeStack": "≤900px",
    "directoryGrid": {
      "desktop": "≥1101px: 3 columnas",
      "tablet": "601–1100px: 2 columnas",
      "mobile": "≤600px: 1 columna"
    },
    "sectionSpacing": {
      "desktop": "96px",
      "tablet": "76px (≤900px)",
      "mobile": "60px (≤600px)"
    }
  }
}
