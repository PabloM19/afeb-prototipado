    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
